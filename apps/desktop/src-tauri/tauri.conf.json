{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vedit",
  "version": "0.1.0",
  "identifier": "io.vedit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ..",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ..",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vedit",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Video",
    "shortDescription": "Vedit — video editor s AI",
    "longDescription": "Desktopový video editor s MCP podporou a přímým API pro AI agenty.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources": "resources"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
