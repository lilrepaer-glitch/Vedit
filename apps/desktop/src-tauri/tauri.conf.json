{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vedit",
  "version": "0.6.2",
  "identifier": "io.vedit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ..",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node prebuild.cjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vedit",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Video",
    "shortDescription": "Vedit — AI-powered video editor",
    "longDescription": "Desktop video editor with built-in MCP server, Vedit Gen AI studio, and direct API for AI agents.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources": "resources"
    },
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "template": "installer.nsi",
        "languages": ["English", "German", "Russian", "SimpChinese"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer-assets/header.bmp",
        "sidebarImage": "installer-assets/welcome.bmp",
        "compression": "lzma",
        "startMenuFolder": "Vedit"
      }
    }
  }
}
